{
  "appId": "com.hardwareshop.pos",
  "productName": "Hardware Khata POS",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/better-sqlite3/**/*",
    "build/icon.png",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*"
  ],
  "npmRebuild": true,
  "afterPack": "scripts/linux-after-pack.cjs",
  "publish": [
    {
      "provider": "github",
      "owner": "shahriar-ahmed-seam",
      "repo": "Hardware-Khata-POS",
      "releaseType": "release"
    }
  ],
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "linux": {
    "icon": "build/icon.png",
    "executableName": "hardware-khata-pos",
    "category": "Office",
    "synopsis": "Offline point of sale and khata for a hardware shop",
    "maintainer": "shahriar-ahmed-seam",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "artifactName": "HardwareKhataPOS-${version}-${arch}.${ext}"
  },
  "deb": {
    "packageName": "hardware-khata-pos",
    "artifactName": "hardware-khata-pos_${version}_${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hardware Khata POS",
    "artifactName": "HardwareKhataPOS-Setup-${version}.${ext}"
  }
}
