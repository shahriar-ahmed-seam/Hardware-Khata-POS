{
  "appId": "com.hardwareshop.pos",
  "productName": "Hardware Khata POS",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/better-sqlite3/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*"
  ],
  "npmRebuild": true,
  "publish": [
    {
      "provider": "github",
      "owner": "shahriar-ahmed-seam",
      "repo": "Hardware-Khata-POS",
      "releaseType": "release"
    }
  ],
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hardware Khata POS",
    "artifactName": "HardwareKhataPOS-Setup-${version}.${ext}"
  }
}
